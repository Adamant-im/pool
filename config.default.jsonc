{
  /**
    List of nodes used to fetch forging information.
    If one node becomes unavailable, the pool will use a healthy one.
  **/
  "node_ADM": [
    "https://bid.adamant.im",
    "http://localhost:36666",
    "https://endless.adamant.im",
    "https://clown.adamant.im",
    "https://debate.adamant.im",
    "https://lake.adamant.im",
    "https://sunshine.adamant.im"
  ],

  /**
    The pool's secret phrase. The pool's ADM address/account will correspond to this passPhrase.
    The account should be a delegate of the ADAMANT blockchain.
  **/
  "passPhrase": "",

  /** Percentage of rewards to distribute to voters **/
  "reward_percentage": 80,

  /** Percentage of rewards to donate to the ADAMANT Foundation **/
  "donate_percentage": 0,

  /**
    Wallet for donation.
    Make sure it's the same as on https://adamant.im/donate
  **/
  "donatewallet": "U380651761819723095",

  /**
    Maintenance wallet to receive (100 - reward_percentage - donate_percentage) rewards.
    To keep this share on the pool wallet, set this value to an empty string.
  **/
  "maintenancewallet": "",

  /**
    How often the pool processes payouts. All schedules run at 00:00.
    1d -> every day
    5d -> days 1, 5, 10, 15, 20, 25 of the month
    10d -> days 1, 10, 20 of the month
    15d -> days 1, 15 of the month
    30d -> 30th of each month
    Mon, Tue, Wed, Thu, Fri, Sat or Sun -> every week
  **/
  "payoutperiod": "Sun",

  /**
    Minimum amount in ADM for a payout. Must not be lower than 0.51.
    If a voter's reward is lower than minpayout at the end of a payout period, it remains pending for the next period.
    Voter pays a transaction fee.
  **/
  "minpayout": 10,

  /** Whether to include the delegate's own vote in reward distribution **/
  "considerownvote": false,

  /** ADAMANT address for monitoring notifications **/
  "adamant_notify": "",

  /** Slack key for monitoring notifications **/
  "slack": "",

  /**
    The software will use verbosity according to log_level.
    Supported levels: none < error < warn < info < log.
  **/
  "log_level": "log",

  /** Port for pool's public Web panel **/
  "port": 36667,

  /** Express server CORS configuration **/
  "cors": {
    "origin": "*",
    "credentials": true
  },

  /** MongoDB connection parameters **/
  "mongodb": {
    "uri": "mongodb://localhost:27017",
    "dbName": "adamant-pool"
  }
}
